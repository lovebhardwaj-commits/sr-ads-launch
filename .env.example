# Meta (Facebook) app — from developers.facebook.com > your app > App settings > Basic
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Random 32+ character string used to encrypt the session cookie.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Required. Production URL of the app, no trailing slash, e.g. https://sr-ads-launch.vercel.app
# The OAuth redirect URI is <APP_URL>/api/auth/callback and must be listed in
# Facebook Login > Settings > Valid OAuth Redirect URIs. Use http://localhost:3000 locally.
APP_URL=


# Optional. Graph API version (default v23.0).
META_API_VERSION=

# Optional. Use Facebook Login for Business: put the configuration ID here and
# the permissions come from that configuration instead of FACEBOOK_SCOPES.
FACEBOOK_CONFIG_ID=

# Optional. Comma-separated override of the requested permissions.
FACEBOOK_SCOPES=

# Optional. AI-written ad text for image and video ads (Qwen through OpenRouter). Without the key the
# feature is hidden. The video is not uploaded through this app: the AI gets a link to the copy on Meta.
OPENROUTER_API_KEY=
# Default qwen/qwen3.7-flash. qwen/qwen3.8-omni-flash also hears the video's audio (costs more).
OPENROUTER_MODEL=
# Default https://openrouter.ai/api/v1. Any OpenAI-compatible gateway works.
OPENROUTER_BASE_URL=
# Set to "deny" to use only providers that don't store prompts (may leave no provider for some models).
OPENROUTER_DATA_COLLECTION=
# Longest video the AI will watch, in seconds (default 300).
AI_MAX_VIDEO_SECONDS=
